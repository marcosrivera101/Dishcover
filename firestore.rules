rules_version = '2';

// Dishcover security rules (step 1 plan): interview answers are owner-only; dishes and
// ratings are readable by signed-in users; only a dish's creator edits or removes it;
// flags and reports are create-only; identity always comes from the auth token.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function isStr(v, max) { return v is string && v.size() <= max; }

    match /users/{uid} {
      allow read, write: if signedIn() && me() == uid;
    }

    match /places/{placeId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == me()
        && isStr(request.resource.data.name, 60)
        && request.resource.data.ratingSum == 0
        && request.resource.data.ratingCount == 0;
      allow update: if signedIn() && (
        // Anyone may refresh Google's cached coordinates; nothing else changes.
        changed().hasOnly(['lat', 'lng', 'gh4', 'coordsCachedAt'])
        // Review totals move only together with the caller's own review of the place.
        || (changed().hasOnly(['ratingSum', 'ratingCount'])
          && request.resource.data.ratingCount - resource.data.ratingCount <= 1
          && request.resource.data.ratingCount - resource.data.ratingCount >= -1
          && request.resource.data.ratingSum - resource.data.ratingSum <= 5
          && request.resource.data.ratingSum - resource.data.ratingSum >= -5
          && (existsAfter(/databases/$(database)/documents/placeRatings/$(placeId + '_' + me()))
            || exists(/databases/$(database)/documents/placeRatings/$(placeId + '_' + me()))))
      );
    }

    match /dishes/{dishId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == me()
        && isStr(request.resource.data.name, 80)
        && isStr(request.resource.data.price, 20)
        && request.resource.data.categories is list
        && request.resource.data.ratingSum == 0
        && request.resource.data.ratingCount == 0;
      allow update: if signedIn() && (
        // The creator edits the details.
        (resource.data.createdBy == me()
          && changed().hasOnly(['name', 'description', 'categories', 'price', 'allergens', 'tags', 'confirmedAt'])
          && isStr(request.resource.data.name, 80))
        // Refreshing the nearby cell along with its place.
        || changed().hasOnly(['gh4'])
        // Rating totals move only together with the caller's own rating document.
        || (changed().hasOnly(['ratingSum', 'ratingCount', 'lastRatedAt'])
          && request.resource.data.ratingCount - resource.data.ratingCount <= 1
          && request.resource.data.ratingCount - resource.data.ratingCount >= -1
          && request.resource.data.ratingSum - resource.data.ratingSum <= 5
          && request.resource.data.ratingSum - resource.data.ratingSum >= -5
          && (existsAfter(/databases/$(database)/documents/ratings/$(dishId + '_' + me()))
            || exists(/databases/$(database)/documents/ratings/$(dishId + '_' + me()))))
      );
      allow delete: if signedIn() && resource.data.createdBy == me();
    }

    match /ratings/{ratingId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.userId == me()
        && ratingId == request.resource.data.dishId + '_' + me()
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && isStr(request.resource.data.text, 500);
      allow delete: if signedIn() && resource.data.userId == me();
    }

    match /placeRatings/{ratingId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.userId == me()
        && ratingId == request.resource.data.dishId + '_' + me()
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && isStr(request.resource.data.text, 500);
      allow delete: if signedIn() && resource.data.userId == me();
    }

    // The "what's new" feed. Entries stay until their author removes them.
    match /feed/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == me()
        && request.resource.data.type in ['menu', 'place', 'review', 'post']
        && isStr(request.resource.data.text, 500)
        && isStr(request.resource.data.placeName, 80)
        && request.resource.data.likeCount == 0;
      // Likes move the counter one step at a time.
      allow update: if signedIn()
        && changed().hasOnly(['likeCount'])
        && request.resource.data.likeCount - resource.data.likeCount <= 1
        && request.resource.data.likeCount - resource.data.likeCount >= -1
        && request.resource.data.likeCount >= 0;
      allow delete: if signedIn() && resource.data.userId == me();
    }

    // App settings published by Marcos (newest version and its download link).
    // A request to look up menus for one ~5 km area (geohash 5). Created once by a visitor, then run by the server.
    match /areas/{cell} {
      allow read: if signedIn();
      allow create: if signedIn() && cell.size() == 5
        && request.resource.data.keys().hasOnly(["status", "requestedAt", "requestedBy"])
        && request.resource.data.status == "waiting"
        && request.resource.data.requestedBy == me();
      allow update, delete: if false;
    }

    // Points, levels and badges: written only by the server, readable so reviews can show levels.
    match /stats/{uid} {
      allow read: if signedIn();
      allow write: if false;
      match /log/{entry} {
        allow read: if signedIn() && me() == uid;
        allow write: if false;
      }
    }

    match /config/{doc} {
      allow read: if signedIn();
    }

    match /flags/{id} {
      allow create: if signedIn() && request.resource.data.by == me();
    }
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.by == me();
    }
    // usage/ counters are written only by the menu-reader function (admin access).
  }
}
